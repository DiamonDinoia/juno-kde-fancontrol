#!/bin/bash
set -e

# The package now owns the whole fan stack under /usr. Machines set up before
# it exist still carry hand-installed copies under /usr/local, which win on
# PATH, and drop-ins under /etc/systemd/system, which win over /usr/lib for
# the same filename. Neither is dpkg's to delete, so report both and let the
# admin decide.
if [ -e /usr/local/bin/fan-profile ] && \
   ! cmp -s /usr/local/bin/fan-profile /usr/bin/fan-profile; then
    cat >&2 <<'EOF'
juno-kde-fancontrol: NOTE
  /usr/local/bin/fan-profile differs from the packaged /usr/bin/fan-profile
  and shadows it on PATH. The packaged systemd drop-in calls /usr/bin
  explicitly, so the CLI and the boot-time regen would run different code.
  Remove the old copy once you are happy with this package:
    sudo rm /usr/local/bin/fan-profile /usr/local/bin/fan-calibrate
EOF
fi

# A drop-in under /etc with the same name as the packaged one shadows it
# entirely (including its Restart policy and ExecStartPre chain); a
# differently-named one only merges key-by-key. Warn and name the file(s);
# removing them is the admin's call, not the installer's.
PKGDROP=/usr/lib/systemd/system/fancontrol.service.d/30-juno-fancontrol.conf
shopt -s nullglob
ovr=(/etc/systemd/system/fancontrol.service.d/*.conf)
if ((${#ovr[@]})); then
    echo "juno-kde-fancontrol: WARNING: drop-in(s) under /etc/systemd/system/fancontrol.service.d/ override the packaged $PKGDROP:" >&2
    printf '  %s\n' "${ovr[@]}" >&2
    echo "  a same-named one shadows it entirely; a differently-named one merges key-by-key." >&2
    echo "  review or remove, or the packaged drop-in's changes may never take effect." >&2
fi
shopt -u nullglob

# Pre-deb-era removal, the name was only ever ours: dpkg removes only the file
# it tracks, so postinst deletes a source-installed unowned copy by name here.
rm -f /usr/lib/systemd/system-sleep/fancontrol-resume

# Neutralize the fancontrol deb's resume hook, which restarts the daemon on
# every resume — and every fancontrol start blips 255 onto each pwm (its
# pwmenable path), so every resume was a full-speed burst. No restart is
# needed: clevofan's PM notifier re-asserts the cached manual duty on
# PM_POST_SUSPEND/PM_POST_HIBERNATION/PM_POST_RESTORE and pwmN_enable survives
# S3/S4. Divert the hook and put a no-op in its place; a fancontrol reinstall
# then rewrites the diverted original, never the live path.
# The divert target MUST be dot-prefixed (or live outside the dir):
# systemd-sleep executes every non-hidden executable in system-sleep/ — only
# dot-names, *~ and a fixed suffix list are skipped — so a visible target like
# $SLP.juno-diverted would keep BOTH hooks running on every resume.
SLP=/usr/lib/systemd/system-sleep/fancontrol
SLP_DIV=/usr/lib/systemd/system-sleep/.fancontrol.juno-diverted
SLP_NOOP=/usr/share/juno-kde-fancontrol/fancontrol-sleep-noop
divertor=$(dpkg-divert --listpackage "$SLP" 2>/dev/null || true)
if [ "$divertor" != "juno-kde-fancontrol" ]; then
    if [ -n "$divertor" ]; then
        echo "juno-kde-fancontrol: WARNING: $SLP is diverted by '$divertor' (expected juno-kde-fancontrol); leaving it alone" >&2
    else
        # A diverted original still on disk means we diverted it before and
        # the entry vanished (admin or a fancontrol reinstall went sideways):
        # that state earns a warning; a first install does not.
        if [ -e "$SLP_DIV" ]; then
            echo "juno-kde-fancontrol: WARNING: $SLP lost its diversion while $SLP_DIV still exists — re-diverting" >&2
        fi
        if ! dpkg-divert --package juno-kde-fancontrol --add --rename --divert "$SLP_DIV" "$SLP"; then
            # Half-state: the entry is gone but a stale diverted copy still
            # sits at $SLP_DIV while the live path carries the upstream hook
            # again, so the --rename above failed (rc 2, "rename involves
            # overwriting") and rolled the entry back. Move the stale copy
            # aside under a fixed name and try the divert once more.
            if [ -e "$SLP_DIV" ]; then
                echo "juno-kde-fancontrol: WARNING: moving stale $SLP_DIV to $SLP_DIV.stale to recover the diversion" >&2
                mv "$SLP_DIV" "$SLP_DIV.stale"
                dpkg-divert --package juno-kde-fancontrol --add --rename --divert "$SLP_DIV" "$SLP" \
                    || echo "juno-kde-fancontrol: WARNING: could not divert $SLP; the upstream resume hook stays live" >&2
            else
                echo "juno-kde-fancontrol: WARNING: could not divert $SLP; the upstream resume hook stays live" >&2
            fi
        fi
    fi
fi
if [ "$(dpkg-divert --listpackage "$SLP" 2>/dev/null || true)" = "juno-kde-fancontrol" ]; then
    # Keep the no-op in place even if something rewrote the hook after diversion.
    install -m 755 "$SLP_NOOP" "$SLP"
fi

if [ -d /run/systemd/system ]; then
    # A failed reload must not abort the install, but it must not vanish either.
    systemctl daemon-reload \
        || echo "juno-kde-fancontrol: systemctl daemon-reload failed" >&2
    # A drop-in only takes effect on the next start. Restarting a fan
    # controller is the admin's call, not the installer's.
    if systemctl is-active --quiet fancontrol.service; then
        cat >&2 <<'EOF'
juno-kde-fancontrol: fancontrol.service is running with its previous config.
  Pick up the packaged drop-in with:
    sudo systemctl restart fancontrol.service
EOF
    fi
fi

#DEBHELPER#

exit 0
